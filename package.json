{
  "name": "colibri-mcp",
  "version": "0.5.6",
  "private": true,
  "description": "MCP server that lets Claude, Copilot, Cursor and any AI agent drive Chrome by reading pages as compact text instead of screenshots, with a local Jev-style form engine (browse_task).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "chrome",
    "playwright",
    "claude",
    "copilot",
    "cursor",
    "ai-agent",
    "token-efficient",
    "jev"
  ],
  "homepage": "https://github.com/t4zxxx1/colibri-mcp#readme",
  "bugs": "https://github.com/t4zxxx1/colibri-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4zxxx1/colibri-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "colibri-mcp": "extension/server/index.js"
  },
  "files": [
    "extension/server/index.js",
    "extension/server/lib/",
    "extension/server/package.json",
    "README.md",
    "README.it.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/functional.mjs && node test/resilience.mjs && node test/v2.mjs && node test/realsite.mjs && node test/captcha.mjs && node test/v052.mjs && node test/v053.mjs && node test/v054.mjs && node test/v055.mjs && node test/v056.mjs",
    "test:live": "node test/live.mjs",
    "calibrate": "node test/calibrate.mjs",
    "bench": "node test/bench.mjs",
    "bench:task": "node test/bench-task.mjs",
    "profile": "node test/profile.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@anthropic-ai/tokenizer": "0.0.4",
    "@playwright/mcp": "0.0.83",
    "@tontoko/fast-playwright-mcp": "^0.2.0",
    "agent-browser": "^0.41.0"
  },
  "engines": {
    "node": ">=18"
  }
}
